@implements IDisposable
@inject CastleService CastleService
@inject TavernService TavernService

<div class="d-flex align-items-center">
	<div class="mx-2">
		<FightTrack />
	</div>
	<Card PlayingCard="CastleService.CurrentEnemy"></Card>
	<div class="m-2">
		<h5 class="m-1">
			<strong>
				Health
				@(CastleService.CurrentEnemy.Health - TavernService.TotalAttack())
			</strong>
		</h5>
		<h5 class="m-1">
			<strong>
				Strength
				@TavernService.GetDamageDealt()
			</strong>
		</h5>
	</div>
	<div class="d-flex">
		@{
			int position = 1;
		}
		@foreach (var attack in TavernService.Fight)
		{
			<div class="d-flex position-relative mx-2">
				@foreach (var card in attack)
				{
					<div style="margin-left: @(position)rem" class="position-absolute translate-middle start-50 top-50">
						<Card PlayingCard="card"></Card>
					</div>
					position++;
				}
			</div>
			position += 3;
		}
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		TavernService.Updated += Refresh;
	}

	private void Refresh()
	{
		StateHasChanged();
	}

	public void Dispose()
	{
		TavernService.Updated -= Refresh;
	}
}