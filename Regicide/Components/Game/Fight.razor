@implements IDisposable
@inject CastleService CastleService
@inject TavernService TavernService

<div class="d-flex align-items-center">
	<div class="mx-2">
		<FightTrack />
	</div>
	<Card PlayingCard="CastleService.CurrentEnemy"></Card>
	<div class="m-2">
		<h5 class="m-1">
			<strong>
				Health
				@(CastleService.CurrentEnemy.Health - TavernService.TotalAttack())
			</strong>
		</h5>
		<h5 class="m-1">
			<strong>
				Strength
				@TavernService.GetDamageDealt()
			</strong>
		</h5>
	</div>
	<div class="d-flex">
		@foreach (var attack in TavernService.Fight)
		{
			<div class="d-flex ms-1 me-5">
				<div class="position-relative">
					<Card PlayingCard="attack[0]"></Card>
					@for (int i = 1; i < attack.Count; i++)
					{
						var card = attack[i];
						<div style="margin-left: @(i)rem" class="position-absolute translate-middle start-50 top-50">
							<Card PlayingCard="card"></Card>
						</div>
					}
				</div>
			</div>
		}
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		TavernService.Updated += Refresh;
	}

	private void Refresh()
	{
		StateHasChanged();
	}

	public void Dispose()
	{
		TavernService.Updated -= Refresh;
	}
}